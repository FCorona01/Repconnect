# ---------------------------------------------------------------------------
# RepConnect environment variables
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser — treat it as public.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database ---------------------------------------------------------------
# LOCAL DEVELOPMENT (docker compose): use these values as-is.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/repconnect"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:54322/repconnect"

# SUPABASE: replace the two values above with your project's connection strings.
#   Supabase Dashboard → Project Settings → Database → Connection string
#
#   DATABASE_URL         → "Transaction pooler"  (port 6543)  — used by the app
#   DIRECT_DATABASE_URL  → "Direct connection"   (port 5432)  — used by migrations
#
# Migrations must use the direct connection: the transaction pooler cannot run
# the session-level statements that CREATE ROLE and similar require.

# --- Supabase Auth ----------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Full administrative access to your project — never expose this
# to the browser, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Internal ---------------------------------------------------------------
# Shared secret protecting cron endpoints. Generate with:
#     openssl rand -base64 32
CRON_SECRET=""
